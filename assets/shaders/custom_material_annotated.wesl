//! =============================================================================
//! Bevy 0.20 WESL (WebGPU Extended Shading Language) 学習用完全解説シェーダー
//! ファイル名: custom_material_annotated.wesl
//! =============================================================================
//! 【WESLとは？】
//! Bevy 0.20から公式採用されたシェーダー言語規格です。
//! WebGPU標準の WGSL（WebGPU Shading Language）を拡張し、
//! - モジュールインポート（import文）
//! - 条件付きコンパイル（@if）
//! - 言語サーバー（wgsl-analyzer）との親和性
//! を実現しています。
//! =============================================================================

// =============================================================================
// 1. モジュールインポート (Module Imports)
// =============================================================================
// Bevyエンジンの標準ライブラリ（bevy_pbr等）から型や関数を取り込みます。
// WGSL標準には `import` がありませんが、WESLの拡張機能によって利用可能です。

// Bevy標準の頂点シェーダー出力構造体（UV座標、法線、ワールド座標、クリップ位置などを含む）
import bevy_pbr::render::forward_io::VertexOutput;

// 相対パスを使った自作シェーダーモジュールからの定数・関数の取り込み例
import super::custom_material_import::COLOR_MULTIPLIER;


// =============================================================================
// 2. 構造体定義とメモリレイアウト (Struct & Alignment Rules)
// =============================================================================
// Rust側（#[derive(AsBindGroup)]）の #[uniform(0)] と一対一で対応する構造体です。
//
// 【GPUメモリのアライメント（配置規則）についての超重要ルール】
// WGSL/WESLでは、構造体のメンバーサイズとアライメント（配置間隔）が厳密に定められています：
// - f32 / u32 / i32 : 4バイト
// - vec2<f32>       : 8バイトアライメント（8の倍数アドレスに配置）
// - vec3<f32>       : 16バイトアライメント（16の倍数アドレスに配置）
// - vec4<f32>       : 16バイトアライメント（16の倍数アドレスに配置）
// - 構造体全体のサイズ: 16の倍数（16バイト境界）にパディング（余白）が取られます。

struct CustomMaterialData {
    // 16バイト (オフセット 0..16) : RGBAカラー値
    base_color: vec4<f32>,

    // 4バイト (オフセット 16..20) : 時間経過による波の速度など
    time_speed: f32,

    // 4バイト (オフセット 20..24) : エフェクトの強度フラグ
    roughness_factor: f32,

    // パディング用余白（16バイトアライメントを維持するため）
    _padding1: f32,
    _padding2: f32,
};


// =============================================================================
// 3. 条件付きコンパイル (@if Directive)
// =============================================================================
// マテリアルの設定やプラットフォーム（WebGL2など）に応じて、
// コンパイル時にシェーダーコードのオン/オフを切り替えます。

@if(USE_CUSTOM_TINT)
var<private> custom_tint_color: vec4<f32> = vec4<f32>(1.0, 0.8, 0.2, 1.0);


// =============================================================================
// 4. バインドグループとバインディング (@group & @binding)
// =============================================================================
// GPUへのデータ受け渡し口（バインドスロット）を定義します。
//
// 【Bevyにおけるグループ番号の約束事】
// - @group(0) : カメラの視野行列、ビューポート、ライトなど（ビュー共通データ）
// - @group(1) : 個々のメッシュのワールド変換行列（Transformデータ）
// - @group(2) : マテリアル固有データ（Rust側で指定した定数: constants::MATERIAL_BIND_GROUP）

// --- Binding 0: Uniformバッファ（Rust側の #[uniform(0)]）---
// var<uniform> は読み取り専用の小規模・高速なバッファデータです。
@group(constants::MATERIAL_BIND_GROUP) @binding(0)
var<uniform> material: CustomMaterialData;

// --- Binding 1: 2Dテクスチャ画像（Rust側の #[texture(1)]）---
// GPU上の画像ピクセル配列を表します。
@group(constants::MATERIAL_BIND_GROUP) @binding(1)
var material_color_texture: texture_2d<f32>;

// --- Binding 2: テクスチャサンプラー（Rust側の #[sampler(2)]）---
// テクスチャを拡大縮小・補間サンプリングする際の設定（線形補間、リピートモードなど）を保持します。
@group(constants::MATERIAL_BIND_GROUP) @binding(2)
var material_color_sampler: sampler;


// =============================================================================
// 5. フラグメントシェーダー関数 (@fragment Entry Point)
// =============================================================================
// 画面上の各ピクセル（フラグメント）の色を計算して出力するメイン関数です。
//
// 【アノテーションの説明】
// - `@fragment`            : この関数がフラグメントシェーダーの進入点（Entry Point）であることを宣言
// - `in: VertexOutput`     : 頂点シェーダーからラスタライザを通り、ピクセルごとに線形補間された入力データ
// - `-> @location(0) vec4<f32>` : レンダリングターゲット（レンダリング画面のカラーバッファ0番）にRGBA(4要素)を返却

@fragment
fn fragment(
    in: VertexOutput,
) -> @location(0) vec4<f32> {
    // -------------------------------------------------------------------------
    // A. UV座標の取得とサンプリング
    // -------------------------------------------------------------------------
    // `in.uv` は 0.0〜1.0 に正規化されたメッシュ表面の2Dテクスチャ座標です（vec2<f32>）。
    let uv: vec2<f32> = in.uv;

    // `textureSample` 関数で、画像データ、サンプラー設定、UV座標から指定ピクセルのRGBA色（vec4<f32>）を取り出します。
    let texture_color: vec4<f32> = textureSample(
        material_color_texture,
        material_color_sampler,
        uv
    );

    // -------------------------------------------------------------------------
    // B. ベースカラーの合成計算
    // -------------------------------------------------------------------------
    // Uniformバッファから渡された `material.base_color` とテクスチャ色を掛け合わせます（要素ごとの乗算）。
    var final_color: vec4<f32> = material.base_color * texture_color;

    // -------------------------------------------------------------------------
    // C. 条件付きロジックや算術演算
    // -------------------------------------------------------------------------
    // 条件付きコンパイルフラグが有効な場合のみ特定のトーン処理を行う例
    @if(USE_CUSTOM_TINT) {
        final_color = final_color * custom_tint_color;
    }

    // 乗数定数を適用
    final_color = final_color * COLOR_MULTIPLIER;

    // アルファ値（透明度）の固定チェック（完全に透明なピクセルは計算を打ち切る等の最適化も可能）
    if (final_color.a < 0.01) {
        discard; // ピクセルの描画を破棄（描画しない）
    }

    // 最終ピクセルカラー（RGBA: 各要素 0.0 〜 1.0）を返却
    return final_color;
}
